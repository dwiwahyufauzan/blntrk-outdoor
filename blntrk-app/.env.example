APP_NAME="BLNTRK Outdoor"
# PRODUCTION: set APP_ENV=production, APP_DEBUG=false, dan SEED_DEFAULT_PASSWORD (kata sandi akun seeder)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SEED_DEFAULT_PASSWORD=
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Proxy tepercaya (IP/CIDR dipisah koma). Isi '*' hanya di balik load balancer berIP dinamis seperti Render.
TRUSTED_PROXIES=

# Isi true untuk memuat data demo (akun *.test, alat, transaksi contoh). JANGAN di produksi sungguhan.
SEED_DEMO=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blntrk_outdoor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Penyimpanan foto alat (public | s3) dan bukti transfer pelanggan (local | s3, harus privat).
# Di hosting berdisk sementara (Render) gunakan s3/Cloudflare R2 agar berkas tidak hilang saat redeploy.
FOTO_DISK=public
BUKTI_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Token pemicu scheduler dari cron eksternal (GET /cron/jadwal). Kosong = endpoint nonaktif.
CRON_TOKEN=
QUEUE_CONNECTION=database

CACHE_STORE=database

# MAIL_MAILER=log berarti email tidak dikirim (tautan "Lupa kata sandi" disembunyikan). Untuk produksi pakai smtp:
# MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, MAIL_USERNAME=..., MAIL_PASSWORD=...
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@blntrkoutdoor.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
